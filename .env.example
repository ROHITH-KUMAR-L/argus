# Controller-only settings. Never copied into worker containers or image layers.
# Copy to .env and fill in. .env is git-ignored.

# OpenAI-compatible chat endpoint used by the LangChain planner (Phase 9+).
# Leave empty to run with the deterministic mock planner.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Planner selection: "mock" (default, required for all security tests) or "llm".
PLANNER=mock

# Hosted tracing stays off pending privacy review (STK-013).
LANGSMITH_TRACING=false
